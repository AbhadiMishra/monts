# Provider selection — set to 'shopify' to switch from mock to live API
VITE_API_PROVIDER=mock

# Shopify credentials (required only when VITE_API_PROVIDER=shopify)
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Feature flags
VITE_ENABLE_MOCK=true

# SEO
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=MONTS
